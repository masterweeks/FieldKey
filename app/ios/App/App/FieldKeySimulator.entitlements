<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator builds only (CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]), so the CarPlay app can be
	     tried in Simulator. Once Apple grants the entitlement, see docs/ios-app.md. -->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
</dict>
</plist>
